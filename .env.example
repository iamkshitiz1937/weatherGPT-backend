# LLM — OpenAI by default. To use Gemini instead, most providers offer an
# OpenAI-compatible endpoint; point LLM_BASE_URL at it and put its key here.
LLM_API_KEY=your_openai_or_gemini_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Weather (from your api_tests/.env — same key works here)
OPENWEATHERMAP_API_KEY=your_key_here

# Translation (same Sarvam key you already verified in api_tests)
SARVAM_API_KEY=your_key_here

# Database — SQLite needs zero setup, good for the hackathon
DATABASE_URL=sqlite:///./weathergpt.db

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000
